{
  "name": "readbooks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, step-by-step reading roadmaps for great technical books.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:spacing": "node scripts/check-spacing.mjs",
    "check:links": "node scripts/check-links.mjs --internal",
    "verify": "npm run check && npm run build && npm run check:spacing",
    "test": "vitest run",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.20",
    "@neondatabase/serverless": "^1.2.0",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
