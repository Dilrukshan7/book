---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PoweredByPassyn from '../../components/PoweredByPassyn.astro';
import { getCurrentUser } from '../../lib/auth';
import { listUserSubscriptions } from '../../lib/subscriptions';
import '../../styles/subscriptions.css';

export const prerender = false;

const user = getCurrentUser(Astro.request);
if (!user) {
  return Astro.redirect('/auth/login?redirect=/account/subscriptions');
}

const allSubs = listUserSubscriptions(user.id);
const activeSubs = allSubs.filter((s) => s.status === 'ACTIVE' && (!s.expires_at || new Date(s.expires_at) > new Date()));
const pastSubs = allSubs.filter((s) => s.status !== 'ACTIVE' || (s.expires_at && new Date(s.expires_at) <= new Date()));
---

<BaseLayout title="My Passes · ReadBooks" description="Manage your active technical book subscriptions and access passes">
  <div class="u-page sub-container">
    <div class="sub-header" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: var(--space-4); text-align: left;">
      <div>
        <span class="sub-header__eyebrow">Account Dashboard</span>
        <h1 class="sub-header__title" style="margin-bottom: var(--space-1);">My Reading Passes</h1>
        <p class="sub-header__desc" style="margin: 0;">
          Signed in as <strong>{user.name}</strong> ({user.email}).
        </p>
      </div>
      <div style="display: flex; align-items: center; gap: var(--space-2);">
        {user.role === 'ADMIN' && (
          <a href="/admin/subscriptions" class="btn-sub btn-sub--secondary" style="width: auto; padding: var(--space-1) var(--space-3); font-size: var(--step--1);">
            Admin View
          </a>
        )}
        <button id="logout-btn" class="btn-sub btn-sub--secondary" style="width: auto; padding: var(--space-1) var(--space-3); font-size: var(--step--1);">
          Sign out
        </button>
      </div>
    </div>

    <!-- Active Subscriptions -->
    <section style="margin-bottom: var(--space-12);">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-4); border-bottom: 1px solid var(--rule); padding-bottom: var(--space-2);">
        <h2 style="font-family: var(--font-serif); font-size: var(--step-1); font-weight: 600; color: var(--ink); margin: 0;">
          Active Passes ({activeSubs.length})
        </h2>
        <PoweredByPassyn />
      </div>

      {activeSubs.length === 0 ? (
        <div style="background: var(--paper-raised); border: 1px dashed var(--rule); padding: 2rem; border-radius: var(--radius-md, 4px); text-align: center;">
          <p style="font-family: var(--face-sans); color: var(--ink-3); margin-bottom: 1rem;">
            You have no active book passes at this moment.
          </p>
          <a href="/subscriptions" class="btn-sub" style="display: inline-flex; width: auto; padding: 0.45rem 1.15rem;">
            Browse Study Passes
          </a>
        </div>
      ) : (
        <div class="pass-ledger">
          <div class="pass-ledger__head">
            <span>Book</span>
            <span>Plan & Access Scope</span>
            <span>Expiration</span>
            <span style="text-align: right;">Actions</span>
          </div>

          <div class="pass-ledger__rows">
            {activeSubs.map((sub) => {
              const expiresDate = sub.expires_at ? new Date(sub.expires_at).toLocaleString() : 'Never';
              const bookName = sub.book_slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
              return (
                <div class="pass-row plan-card plan-card--featured" id={`sub-${sub.id}`}>
                  <div class="pass-row__main">
                    <span class="badge badge--active" style="display: inline-block; width: fit-content; margin-bottom: 2px;">ACTIVE</span>
                    <h3 class="pass-row__name">
                      <a href={`/books/${sub.book_slug}`} style="color: var(--ink); text-decoration: none;">
                        {bookName}
                      </a>
                    </h3>
                  </div>

                  <div class="pass-row__desc">
                    <strong style="color: var(--ink);">{sub.plan_name}</strong>
                    {sub.passyn_access_id && (
                      <span style="display: block; font-family: var(--face-mono); font-size: 10px; color: var(--ink-muted); margin-top: 2px;">
                        Ref: #{sub.passyn_access_id.slice(-10)}
                      </span>
                    )}
                  </div>

                  <div class="pass-row__price" style="flex-direction: column; align-items: flex-start; gap: 0;">
                    <span style="font-family: var(--face-mono); font-size: 11px; color: var(--status-complete); font-weight: 600;">
                      {expiresDate}
                    </span>
                    <span style="font-family: var(--face-sans); font-size: 10px; color: var(--ink-muted);">
                      Activated {sub.activated_at ? new Date(sub.activated_at).toLocaleDateString() : '—'}
                    </span>
                  </div>

                  <div class="pass-row__action" style="display: flex; gap: 0.35rem; justify-content: flex-end;">
                    <a href={`/books/${sub.book_slug}`} class="btn-sub" style="padding: 0.35rem 0.65rem; font-size: var(--t-micro, 11px);">
                      Read
                    </a>
                    <button
                      type="button"
                      class="btn-sub btn-sub--danger cancel-sub-btn"
                      data-sub-id={sub.id}
                      style="padding: 0.35rem 0.65rem; font-size: var(--t-micro, 11px); min-width: auto;"
                    >
                      Cancel
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </section>

    <!-- Past / Inactive Subscriptions -->
    {pastSubs.length > 0 && (
      <section style="margin-bottom: var(--space-8);">
        <h2 style="font-family: var(--font-serif); font-size: var(--step-1); font-weight: 600; color: var(--ink); margin-bottom: var(--space-4); border-bottom: 1px solid var(--rule); padding-bottom: var(--space-2);">
          Pass History ({pastSubs.length})
        </h2>
        <div class="table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Book</th>
                <th>Plan</th>
                <th>Status</th>
                <th>Activated</th>
                <th>Ended / Expired</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              {pastSubs.map((sub) => (
                <tr>
                  <td>
                    <strong>{sub.book_slug}</strong>
                  </td>
                  <td>{sub.plan_name}</td>
                  <td>
                    <span class={`badge badge--${sub.status.toLowerCase()}`}>
                      {sub.status}
                    </span>
                  </td>
                  <td>{sub.activated_at ? new Date(sub.activated_at).toLocaleDateString() : '—'}</td>
                  <td>{sub.expires_at ? new Date(sub.expires_at).toLocaleDateString() : '—'}</td>
                  <td style="font-size: var(--step--2); color: var(--ink-3);">
                    {sub.revoke_reason || '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </div>

  <script is:inline>
    // Logout handler
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/books';
    });

    // Cancel subscription buttons
    document.querySelectorAll('.cancel-sub-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const subId = btn.getAttribute('data-sub-id');
        if (!confirm('Are you sure you want to cancel this pass? You will immediately lose access to protected study guides.')) {
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Cancelling...';

        try {
          const res = await fetch('/api/subscriptions/cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subscriptionId: subId, reason: 'Cancelled by customer' }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert(data.error?.message || 'Failed to cancel subscription');
            btn.disabled = false;
            btn.textContent = 'Cancel';
          }
        } catch {
          alert('Network error. Could not cancel.');
          btn.disabled = false;
          btn.textContent = 'Cancel';
        }
      });
    });
  </script>
</BaseLayout>
