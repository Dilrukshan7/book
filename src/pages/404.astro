---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <div class="u-page notfound">
    <p class="notfound__code">404</p>
    <h1 class="u-h1 notfound__title">This page is not here</h1>
    <p class="notfound__body">
      The link may be out of date, or the book may have moved. Everything
      available is listed on the home page.
    </p>
    <p class="notfound__actions">
      <a class="btn" href="/">
        Browse the books
        <span class="btn__arrow" aria-hidden="true">&#8594;</span>
      </a>
    </p>
  </div>
</BaseLayout>
