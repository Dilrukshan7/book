---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PoweredByPassyn from '../components/PoweredByPassyn.astro';
import { getCurrentUser } from '../lib/auth';
import {
  listAllPlans,
  listUserSubscriptions,
  seedDefaultPlansIfMissing,
} from '../lib/subscriptions';
import '../styles/subscriptions.css';

export const prerender = false;

await seedDefaultPlansIfMissing();
const user = await getCurrentUser(Astro.request);
const allPlans = (await listAllPlans()).filter((p) => p.is_active === 1);
const userSubs = user ? await listUserSubscriptions(user.id) : [];
const activeSubsMap = new Map<string, typeof userSubs[0]>();

for (const sub of userSubs) {
  if (sub.status === 'ACTIVE' && (!sub.expires_at || new Date(sub.expires_at) > new Date())) {
    activeSubsMap.set(sub.book_slug, sub);
  }
}

const books = await getCollection('books');
const availableBooks = books.filter((b) => b.data.status === 'available');

// Group plans by book
const plansByBook = availableBooks.map((book) => {
  const plans = allPlans.filter((p) => p.book_slug === book.data.slug);
  const activeSub = activeSubsMap.get(book.data.slug);
  return {
    book: book.data,
    plans,
    activeSub,
  };
});
---

<BaseLayout
  title="Study Passes & Access · ReadBooks"
  description="Flexible, time-bounded passes for chapter study guides, problem breakdowns, and roadmap milestones."
>
  <div class="u-page sub-container">
    <!-- Minimalist Editorial Header -->
    <header class="sub-header">
      <span class="sub-header__eyebrow">Study Access</span>
      <h1 class="sub-header__title">
        Reading Passes
      </h1>
      <p class="sub-header__desc">
        Direct, unmetered access to chapter study notes, worked examples, and problem walkthroughs.
        Choose a focused sprint window — with zero recurring subscriptions.
      </p>

      {user ? (
        <div style="margin-top: var(--s-4, 1rem); display: inline-flex; align-items: center; gap: 0.75rem; background: var(--paper-raised); padding: 0.4rem 0.85rem; border-radius: var(--radius-sm, 3px); border: 1px solid var(--rule);">
          <span style="font-family: var(--face-sans); font-size: var(--t-sm, 0.85rem); color: var(--ink-2);">
            Signed in as <strong>{user.name}</strong> ({user.email})
          </span>
          <a href="/account/subscriptions" class="btn-sub btn-sub--secondary" style="padding: 0.2rem 0.55rem; font-size: var(--t-micro, 11px);">
            My Passes
          </a>
        </div>
      ) : (
        <div style="margin-top: var(--s-4, 1rem); display: flex; justify-content: center; gap: 0.75rem;">
          <a href="/auth/register?redirect=/subscriptions" class="btn-sub">
            Create Account
          </a>
          <a href="/auth/login?redirect=/subscriptions" class="btn-sub btn-sub--secondary">
            Sign In
          </a>
        </div>
      )}
    </header>

    <!-- Books and Plans Pass Ledgers -->
    {plansByBook.map(({ book, plans, activeSub }) => (
      <section style="margin-bottom: var(--s-9, 2.5rem);">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.5rem;">
          <div>
            <h2 style="font-family: var(--face-serif); font-size: 1.45rem; font-weight: 600; color: var(--ink); margin: 0;">
              <a href={`/books/${book.slug}`} style="color: var(--ink); text-decoration: none;">
                {book.title}
              </a>
            </h2>
            <p style="font-family: var(--face-sans); font-size: var(--t-sm, 0.85rem); color: var(--ink-3); margin-top: 2px;">
              by {book.author} ({book.year})
            </p>
          </div>

          <div>
            {activeSub ? (
              <span class="badge badge--active" style="padding: 3px 8px;">
                ✓ Active pass until {new Date(activeSub.expires_at || '').toLocaleDateString()}
              </span>
            ) : (
              <a href={`/books/${book.slug}`} class="btn-sub btn-sub--secondary" style="padding: 0.3rem 0.65rem; font-size: var(--t-sm, 0.85rem);">
                View Roadmap →
              </a>
            )}
          </div>
        </div>

        {activeSub && (
          <div style="background: var(--paper-raised); border: 1px solid var(--rule); border-left: 3px solid var(--status-complete); border-radius: var(--radius-sm, 3px); padding: 0.85rem 1.25rem; margin-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
            <div>
              <strong style="color: var(--ink); font-family: var(--face-sans); font-size: var(--t-sm, 0.85rem);">
                Current Pass: {activeSub.plan_name}
              </strong>
              <div style="font-size: var(--t-sm, 0.85rem); color: var(--ink-3); margin-top: 2px;">
                Unrestricted access to all study guides until {new Date(activeSub.expires_at || '').toLocaleString()}.
              </div>
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <a href={`/books/${book.slug}`} class="btn-sub" style="padding: 0.35rem 0.75rem; font-size: var(--t-sm, 0.85rem);">
                Read Guides
              </a>
              <a href="/account/subscriptions" class="btn-sub btn-sub--secondary" style="padding: 0.35rem 0.75rem; font-size: var(--t-sm, 0.85rem);">
                Manage
              </a>
            </div>
          </div>
        )}

        <!-- Archival Minimalist Pass Register -->
        <div class="pass-ledger">
          <div class="pass-ledger__head">
            <span>Duration</span>
            <span>Study Scope & Access</span>
            <span>Price</span>
            <span style="text-align: right;">Action</span>
          </div>

          <div class="pass-ledger__rows">
            {plans.map((p, idx) => {
              const isFeatured = idx === 1;
              const periodLabel = p.duration_hours >= 720 ? '30 Days' : p.duration_hours >= 168 ? '7 Days' : `${p.duration_hours} Hours`;
              return (
                <div class={`pass-row plan-card ${isFeatured ? 'plan-card--featured pass-row--featured' : ''}`}>
                  <div class="pass-row__main">
                    <span class={`pass-row__tag ${isFeatured ? 'pass-row__tag--popular' : ''}`}>
                      {periodLabel}
                    </span>
                    <h3 class="pass-row__name">{p.name}</h3>
                  </div>

                  <div class="pass-row__desc">
                    {p.description || 'Full unmetered access to chapter study guides, worked examples, and problem sets.'}
                  </div>

                  <div class="pass-row__price">
                    <span class="pass-row__amount">${p.price.toFixed(2)}</span>
                    <span class="pass-row__cur">{p.currency}</span>
                  </div>

                  <div class="pass-row__action">
                    {activeSub ? (
                      <button type="button" class="btn-sub btn-sub--secondary" disabled>
                        Pass Active
                      </button>
                    ) : user ? (
                      <button
                        type="button"
                        class="btn-sub purchase-pass-btn"
                        data-plan-id={p.id}
                        data-book-slug={book.slug}
                      >
                        Get Pass
                      </button>
                    ) : (
                      <a
                        href={`/auth/login?redirect=${encodeURIComponent('/subscriptions')}`}
                        class="btn-sub btn-sub--secondary"
                      >
                        Sign In
                      </a>
                    )}
                  </div>
                </div>
              );
            })}
          </div>

          <div class="pass-ledger__foot">
            <span>One-time access passes &middot; No recurring charges &middot; Immediate activation</span>
            <PoweredByPassyn />
          </div>
        </div>
      </section>
    ))}

    <!-- FAQ Section -->
    <section style="background: var(--paper-raised); border: 1px solid var(--rule); border-radius: var(--radius-md, 4px); padding: 1.5rem 1.75rem; margin-top: var(--s-8, 2rem);">
      <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--rule-subtle); padding-bottom: 0.75rem;">
        <h2 style="font-family: var(--face-serif); font-size: 1.35rem; font-weight: 600; color: var(--ink); margin: 0;">
          Frequently Asked Questions
        </h2>
        <PoweredByPassyn />
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        <div>
          <h3 style="font-family: var(--face-serif); font-size: 1.05rem; font-weight: 600; margin-bottom: 0.25rem; color: var(--ink);">
            What is included in a study pass?
          </h3>
          <p style="font-family: var(--face-sans); font-size: var(--t-sm, 0.85rem); color: var(--ink-3); line-height: 1.5;">
            Study passes grant unrestricted access to full chapter study guides, step-by-step problem walkthroughs, and key formula summaries.
          </p>
        </div>

        <div>
          <h3 style="font-family: var(--face-serif); font-size: 1.05rem; font-weight: 600; margin-bottom: 0.25rem; color: var(--ink);">
            What material is free?
          </h3>
          <p style="font-family: var(--face-sans); font-size: var(--t-sm, 0.85rem); color: var(--ink-3); line-height: 1.5;">
            The comprehensive book roadmaps, section ordering, and links to free university lectures remain permanently open to all readers.
          </p>
        </div>

        <div>
          <h3 style="font-family: var(--face-serif); font-size: 1.05rem; font-weight: 600; margin-bottom: 0.25rem; color: var(--ink);">
            Do passes renew automatically?
          </h3>
          <p style="font-family: var(--face-sans); font-size: var(--t-sm, 0.85rem); color: var(--ink-3); line-height: 1.5;">
            No. Reading passes are designed around dedicated study sprints (24 hours, 7 days, or 30 days). Passes expire naturally without recurring charges.
          </p>
        </div>

        <div>
          <h3 style="font-family: var(--face-serif); font-size: 1.05rem; font-weight: 600; margin-bottom: 0.25rem; color: var(--ink);">
            Can I manage or cancel passes?
          </h3>
          <p style="font-family: var(--face-sans); font-size: var(--t-sm, 0.85rem); color: var(--ink-3); line-height: 1.5;">
            Yes. You can inspect all active passes and timestamps directly from your <a href="/account/subscriptions" style="color: var(--accent); text-decoration: underline;">account dashboard</a> anytime.
          </p>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    document.querySelectorAll('.purchase-pass-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const planId = btn.getAttribute('data-plan-id');
        const bookSlug = btn.getAttribute('data-book-slug');

        btn.disabled = true;
        btn.textContent = 'Activating...';

        try {
          const res = await fetch('/api/subscriptions/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ planId, bookSlug }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert(data.error?.message || 'Subscription activation failed');
            btn.disabled = false;
            btn.textContent = 'Get Pass';
          }
        } catch {
          alert('Network error. Please try again.');
          btn.disabled = false;
          btn.textContent = 'Get Pass';
        }
      });
    });
  </script>
</BaseLayout>
