---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PoweredByPassyn from '../components/PoweredByPassyn.astro';
import { getCurrentUser } from '../lib/auth';
import {
  listAllPlans,
  listUserSubscriptions,
  seedDefaultPlansIfMissing,
} from '../lib/subscriptions';
import '../styles/subscriptions.css';

export const prerender = false;

await seedDefaultPlansIfMissing();
const user = getCurrentUser(Astro.request);
const allPlans = listAllPlans().filter((p) => p.is_active === 1);
const userSubs = user ? listUserSubscriptions(user.id) : [];
const activeSubsMap = new Map<string, typeof userSubs[0]>();

for (const sub of userSubs) {
  if (sub.status === 'ACTIVE' && (!sub.expires_at || new Date(sub.expires_at) > new Date())) {
    activeSubsMap.set(sub.book_slug, sub);
  }
}

const books = await getCollection('books');
const availableBooks = books.filter((b) => b.data.status === 'available');

// Group plans by book
const plansByBook = availableBooks.map((book) => {
  const plans = allPlans.filter((p) => p.book_slug === book.data.slug);
  const activeSub = activeSubsMap.get(book.data.slug);
  return {
    book: book.data,
    plans,
    activeSub,
  };
});
---

<BaseLayout
  title="Study Passes & Access · ReadBooks"
  description="Flexible, time-bounded passes for chapter study guides, problem breakdowns, and roadmap milestones."
>
  <div class="u-page sub-container">
    <!-- Minimalist Editorial Header -->
    <header class="sub-header">
      <span class="sub-header__eyebrow">Study Access</span>
      <h1 class="sub-header__title">
        Reading Passes
      </h1>
      <p class="sub-header__desc">
        Direct, unmetered access to chapter study notes, worked examples, and problem walkthroughs.
        Choose a focused sprint window — with zero recurring subscriptions.
      </p>

      {user ? (
        <div style="margin-top: var(--space-4); display: inline-flex; align-items: center; gap: var(--space-3); background: var(--paper-raised); padding: var(--space-2) var(--space-4); border-radius: 4px; border: 1px solid var(--rule);">
          <span style="font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-2);">
            Signed in as <strong>{user.name}</strong> ({user.email})
          </span>
          <a href="/account/subscriptions" class="btn-sub btn-sub--secondary" style="width: auto; padding: 2px 10px; font-size: var(--step--2);">
            My Passes
          </a>
        </div>
      ) : (
        <div style="margin-top: var(--space-4); display: flex; justify-content: center; gap: var(--space-3);">
          <a href="/auth/register?redirect=/subscriptions" class="btn-sub" style="width: auto; padding: var(--space-2) var(--space-5);">
            Create Account
          </a>
          <a href="/auth/login?redirect=/subscriptions" class="btn-sub btn-sub--secondary" style="width: auto; padding: var(--space-2) var(--space-5);">
            Sign In
          </a>
        </div>
      )}
    </header>

    <!-- Books and Plans Sections -->
    {plansByBook.map(({ book, plans, activeSub }) => (
      <section style="margin-bottom: var(--space-12);">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-6); border-bottom: 1px solid var(--rule); padding-bottom: var(--space-3);">
          <div>
            <h2 style="font-family: var(--font-serif); font-size: var(--step-2); font-weight: 600; color: var(--ink); margin: 0;">
              <a href={`/books/${book.slug}`} style="color: var(--ink); text-decoration: none;">
                {book.title}
              </a>
            </h2>
            <p style="font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-3); margin-top: 2px;">
              by {book.author} ({book.year})
            </p>
          </div>

          <div>
            {activeSub ? (
              <span class="badge badge--active" style="padding: 4px 10px;">
                ✓ Active pass until {new Date(activeSub.expires_at || '').toLocaleDateString()}
              </span>
            ) : (
              <a href={`/books/${book.slug}`} class="btn-sub btn-sub--secondary" style="width: auto; padding: var(--space-1) var(--space-3); font-size: var(--step--1);">
                View Roadmap →
              </a>
            )}
          </div>
        </div>

        {activeSub && (
          <div style="background: var(--paper-raised); border: 1px solid var(--rule); border-left: 3px solid var(--status-complete); border-radius: 4px; padding: var(--space-4) var(--space-6); margin-bottom: var(--space-6); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-4);">
            <div>
              <strong style="color: var(--ink); font-family: var(--font-sans); font-size: var(--step--1);">
                Current Pass: {activeSub.plan_name}
              </strong>
              <div style="font-size: var(--step--1); color: var(--ink-3); margin-top: 2px;">
                Unrestricted access to all study guides until {new Date(activeSub.expires_at || '').toLocaleString()}.
              </div>
            </div>
            <div style="display: flex; gap: var(--space-2);">
              <a href={`/books/${book.slug}`} class="btn-sub" style="width: auto; padding: var(--space-1) var(--space-3); font-size: var(--step--1);">
                Read Guides
              </a>
              <a href="/account/subscriptions" class="btn-sub btn-sub--secondary" style="width: auto; padding: var(--space-1) var(--space-3); font-size: var(--step--1);">
                Manage
              </a>
            </div>
          </div>
        )}

        <div class="plans-grid">
          {plans.map((p, idx) => {
            const isFeatured = idx === 1;
            const periodLabel = p.duration_hours >= 720 ? '30 days' : p.duration_hours >= 168 ? '7 days' : `${p.duration_hours} hours`;
            return (
              <div class={`plan-card ${isFeatured ? 'plan-card--featured' : ''}`}>
                {isFeatured && <span class="plan-card__badge">POPULAR</span>}
                <h3 class="plan-card__title">{p.name}</h3>
                <p class="plan-card__meta">{periodLabel} access</p>

                <div class="plan-card__price-wrap">
                  <span class="plan-card__price">${p.price.toFixed(2)}</span>
                  <span class="plan-card__currency">{p.currency}</span>
                  <span class="plan-card__period">/ {periodLabel}</span>
                </div>

                <p class="plan-card__desc">
                  {p.description || 'Full unmetered access to study guides, interactive notes, and problem sets.'}
                </p>

                <ul class="plan-card__features">
                  <li>Complete chapter study guides</li>
                  <li>Problem set and solution walkthroughs</li>
                  <li>Instant activation across all devices</li>
                  <li>Auto-expires without recurring renewals</li>
                </ul>

                {activeSub ? (
                  <button type="button" class="btn-sub btn-sub--secondary" disabled style="opacity: 0.7;">
                    Pass Active
                  </button>
                ) : user ? (
                  <button
                    type="button"
                    class="btn-sub purchase-pass-btn"
                    data-plan-id={p.id}
                    data-book-slug={book.slug}
                  >
                    Get Pass (${p.price.toFixed(2)})
                  </button>
                ) : (
                  <a
                    href={`/auth/login?redirect=${encodeURIComponent('/subscriptions')}`}
                    class="btn-sub btn-sub--secondary"
                    style="text-align: center;"
                  >
                    Sign In to Unlock
                  </a>
                )}
              </div>
            );
          })}
        </div>

        <!-- Discreet Powered by Passyn indicator -->
        <div style="display: flex; justify-content: flex-end; margin-top: var(--space-2);">
          <PoweredByPassyn />
        </div>
      </section>
    ))}

    <!-- FAQ Section -->
    <section style="background: var(--paper-raised); border: 1px solid var(--rule); border-radius: 4px; padding: var(--space-6) var(--space-8); margin-top: var(--space-10);">
      <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-6); border-bottom: 1px solid var(--rule-subtle); padding-bottom: var(--space-3);">
        <h2 style="font-family: var(--font-serif); font-size: var(--step-1); font-weight: 600; color: var(--ink); margin: 0;">
          Frequently Asked Questions
        </h2>
        <PoweredByPassyn />
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6);">
        <div>
          <h3 style="font-family: var(--font-serif); font-size: var(--step-0); font-weight: 600; margin-bottom: var(--space-1); color: var(--ink);">
            What is included in a study pass?
          </h3>
          <p style="font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-3); line-height: var(--leading-relaxed);">
            Study passes grant unrestricted access to full chapter study guides, step-by-step problem walkthroughs, and key formula summaries.
          </p>
        </div>

        <div>
          <h3 style="font-family: var(--font-serif); font-size: var(--step-0); font-weight: 600; margin-bottom: var(--space-1); color: var(--ink);">
            What material is free?
          </h3>
          <p style="font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-3); line-height: var(--leading-relaxed);">
            The comprehensive book roadmaps, section ordering, and links to free university lectures remain permanently open to all readers.
          </p>
        </div>

        <div>
          <h3 style="font-family: var(--font-serif); font-size: var(--step-0); font-weight: 600; margin-bottom: var(--space-1); color: var(--ink);">
            Do passes renew automatically?
          </h3>
          <p style="font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-3); line-height: var(--leading-relaxed);">
            No. Reading passes are designed around dedicated study sprints (24 hours, 7 days, or 30 days). Passes expire naturally without recurring charges.
          </p>
        </div>

        <div>
          <h3 style="font-family: var(--font-serif); font-size: var(--step-0); font-weight: 600; margin-bottom: var(--space-1); color: var(--ink);">
            Can I manage or cancel passes?
          </h3>
          <p style="font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-3); line-height: var(--leading-relaxed);">
            Yes. You can inspect all active passes and timestamps directly from your <a href="/account/subscriptions" style="color: var(--accent); text-decoration: underline;">account dashboard</a> anytime.
          </p>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    document.querySelectorAll('.purchase-pass-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const planId = btn.getAttribute('data-plan-id');
        const bookSlug = btn.getAttribute('data-book-slug');

        btn.disabled = true;
        btn.textContent = 'Activating pass...';

        try {
          const res = await fetch('/api/subscriptions/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ planId, bookSlug }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert(data.error?.message || 'Subscription activation failed');
            btn.disabled = false;
            btn.textContent = 'Get Pass';
          }
        } catch {
          alert('Network error. Please try again.');
          btn.disabled = false;
          btn.textContent = 'Get Pass';
        }
      });
    });
  </script>
</BaseLayout>
