---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCatalog from '../components/BookCatalog.astro';
import AiGuideGenerator from '../components/AiGuideGenerator.astro';
import { resolveSectionLinks } from '../lib/books';
import { SITE } from '../site.config';
import '../styles/home.css';

const entries = await getCollection('books');
const books = entries
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

const available = books.filter((b) => b.status === 'available');
const featured = available[0];

/* The hero specimen shows the real component with real rows from the real
   book, rather than a mock-up of one. */
const specimen = featured
  ? featured.parts[0]!.sections.slice(0, 4).map((section, i) => ({
      code: section.code,
      title: section.title,
      sources: resolveSectionLinks(featured, section)
        .map((l) => l.label)
        .join(', '),
      read: i < 2,
      here: i === 2,
    }))
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      inLanguage: SITE.locale,
      publisher: {
        '@type': 'Organization',
        '@id': `${SITE.url}/#organization`,
        name: SITE.name,
        url: SITE.url,
        logo: `${SITE.url}/favicon.svg`,
        sameAs: [SITE.repo],
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE.url}/books?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${SITE.url}/#webpage`,
      url: SITE.url,
      name: `${SITE.name}: ${SITE.tagline}`,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#organization` },
      description: SITE.description,
      inLanguage: SITE.locale,
      hasPart: available.map((book) => ({
        '@type': 'Book',
        name: book.title,
        author: { '@type': 'Person', name: book.author },
        url: `${SITE.url}/books/${book.slug}`,
      })),
    },
  ],
};
---

<BaseLayout
  title={`${SITE.name}: ${SITE.tagline}`}
  description={SITE.description}
  suffix={false}
  jsonLd={jsonLd}
>
  {/* 1. Hero: asymmetric split, live specimen on the right */}
  <section class="u-page hero">
    <div class="hero__intro">
      <div class="hero__badge">
        <span class="badge badge--accent">Scholarly Technical Roadmaps</span>
      </div>
      <h1 class="hero__title">
        Free material for hard books,{' '}
        <span class="hero__em">in order</span>.
      </h1>
      <p class="hero__sub">
        Lectures, sample chapters, and problem sets published free by the
        authors and universities who created them. Sequenced section by section.
      </p>
      {
        featured && (
          <div class="hero__action-group">
            <div class="hero__actions">
              <a class="btn" href={`/books/${featured.slug}`}>
                <span>Open the roadmap</span>
                <span class="btn__arrow" aria-hidden="true">&#8594;</span>
              </a>
              <a class="btn btn--secondary" href="/about">
                <span>How it works</span>
              </a>
            </div>
            <p class="hero__note">
              No paywalls &middot; No accounts &middot; Progress kept on your device
            </p>
          </div>
        )
      }
    </div>

    {
      featured && (
        <div class="specimen" data-reveal>
          <div class="specimen__head">
            <span class="specimen__tag">Interactive Preview</span>
            <span class="specimen__part">Part {featured.parts[0]!.id}: {featured.parts[0]!.title}</span>
          </div>
          <div class="specimen__rows">
            {specimen.map((row) => (
              <div
                class="specimen__row"
                data-read={row.read ? '' : undefined}
                data-here={row.here ? '' : undefined}
              >
                <span class="specimen__mark" aria-hidden="true" />
                <span class="specimen__code">{row.code}</span>
                <div class="specimen__content">
                  <span class="specimen__name">{row.title}</span>
                  <span class="specimen__src">{row.sources}</span>
                </div>
              </div>
            ))}
          </div>
          <div class="specimen__foot">
            <span class="specimen__legend-dot specimen__legend-dot--read" aria-hidden="true"></span>
            <span>Read</span>
            <span class="specimen__legend-dot specimen__legend-dot--here" aria-hidden="true"></span>
            <span>Next up (where you left off)</span>
          </div>
        </div>
      )
    }
  </section>

  {/* 2. Premise: single editorial column against a wide measure */}
  <section class="u-page u-band premise" data-reveal>
    <div class="premise__header">
      <span class="u-label">The Challenge</span>
      <h2 class="premise__lead">
        The material is already free. It is almost never in the book's order.
      </h2>
    </div>
    <div class="premise__body">
      <p>
        A serious textbook often has a great deal published around it. The
        author posts sample chapters. The university puts the entire course
        online as video. The problem sets and the solutions go up too.
      </p>
      <p>
        Then it sits there, unusable. Lectures are numbered by the course, not
        the book. Three sections have a free chapter and the other forty-three
        do not. The problem sets arrive as one combined file. Working out what
        to read after section I.7 means searching three sites, every time.
      </p>
      <p class="premise__highlight">
        <strong>These roadmaps put that material back into the book's own sequence</strong>{' '}
        and keep your place in it automatically.
      </p>
    </div>
  </section>

  {/* 3. The books: all available roadmaps */}
  <section class="u-page u-band books-catalog" aria-labelledby="books-heading" data-reveal>
    <div class="books-catalog__head" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: var(--s-4);">
      <div>
        <span class="u-label">Roadmaps Catalog &amp; Discovery</span>
        <h2 class="u-h2" id="books-heading">Explore Technical Roadmaps</h2>
        <p class="books-catalog__sub">
          Structured step-by-step paths through hard textbooks, with free lectures, problem sets, and personal progress tracking.
        </p>
      </div>

      <div>
        <AiGuideGenerator />
      </div>
    </div>

    <BookCatalog books={available} />
  </section>

  {/* 4. What a roadmap carries: numbered sequence, no cards */}
  <section class="u-page u-band" aria-labelledby="seq-heading" data-reveal>
    <div class="seq-head">
      <span class="u-label">Features & Structure</span>
      <h2 class="u-h2" id="seq-heading">What a roadmap carries</h2>
    </div>
    <div class="seq">
      <div class="seq__item">
        <div class="seq__badge">
          <span class="seq__num">01</span>
        </div>
        <h3 class="seq__title">The contents, in sequence</h3>
        <p class="seq__body">
          Every section of the book in the order the author wrote it, each one
          linked to the lecture that covers it, the problem set, and the
          chapter itself where a free one exists.
        </p>
      </div>
      <div class="seq__item">
        <div class="seq__badge">
          <span class="seq__num">02</span>
        </div>
        <h3 class="seq__title">Your place, and how far in</h3>
        <p class="seq__body">
          Tick sections off as you read. The next one is marked, so returning
          after two weeks away takes one glance rather than five minutes of
          hunting.
        </p>
      </div>
      <div class="seq__item">
        <div class="seq__badge">
          <span class="seq__num">03</span>
        </div>
        <h3 class="seq__title">Study guides, where they help</h3>
        <p class="seq__body">
          For key sections we write our own: what the section is really
          about, what it sets up later in the book, and where people
          reliably get stuck.
        </p>
      </div>
    </div>
  </section>

  {/* 5. Position: ruled statement band */}
  <section class="u-page u-band position" aria-labelledby="position-heading" data-reveal>
    <div class="position__card">
      <span class="u-label">Open Access Commitment</span>
      <h2 class="position__claim" id="position-heading">
        What we host, and what we do not.
      </h2>
      <div class="position__body">
        <p>
          We host no copyrighted books, chapters or PDFs. None are in the
          repository and none are served from this domain. Every reading link
          points at the server of the author or the university that chose to
          publish that material freely.
        </p>
        <p>
          There is no account, no advertising, no tracking, and nothing for
          sale. Your progress is kept in your own browser and is never sent
          anywhere, because there is nowhere to send it. The site is static
          files on a free tier, which is why it can stay this way.
        </p>
        <p>
          Where a book is sold, we link to buy it. Following a roadmap is a
          supplement to owning the book, not a replacement for it. The full
          position is on the <a href="/copyright">copyright page</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

