---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  findSection,
  resolveSectionLinks,
  sectionAnchor,
  sectionCodes,
  sectionHref,
  sectionSlug,
} from '../../../lib/books';
import { SITE } from '../../../site.config';
import '../../../styles/guide.css';

export async function getStaticPaths() {
  const books = await getCollection('books');
  const allGuides = await getCollection('guides');

  return books
    .filter((bookEntry) => bookEntry.data.status === 'available')
    .flatMap((bookEntry) => {
      const order = sectionCodes(bookEntry.data);
      const bookGuides = allGuides
        .filter((g) => g.id.startsWith(`${bookEntry.id}/`))
        .sort(
          (a, b) =>
            order.indexOf(a.data.section) - order.indexOf(b.data.section),
        );

      return bookGuides.map((guide, index) => {
        const found = findSection(bookEntry.data, guide.data.section);
        // A guide pointing at a section code the book does not contain
        // would otherwise render an orphan page; fail the build instead.
        if (!found) {
          throw new Error(
            `Study guide "${guide.id}.md" declares section "${guide.data.section}", ` +
              `which does not exist in book "${bookEntry.id}".`,
          );
        }

        return {
          params: {
            slug: bookEntry.data.slug,
            section: sectionSlug(found.section.code),
          },
          props: {
            bookEntry,
            guide,
            prev: bookGuides[index - 1] ?? null,
            next: bookGuides[index + 1] ?? null,
          },
        };
      });
    });
}

interface Props {
  bookEntry: CollectionEntry<'books'>;
  guide: CollectionEntry<'guides'>;
  prev: CollectionEntry<'guides'> | null;
  next: CollectionEntry<'guides'> | null;
}

const { bookEntry, guide, prev, next } = Astro.props as Props;
const book = bookEntry.data;

const found = findSection(book, guide.data.section)!;
const { section, part } = found;
const links = resolveSectionLinks(book, section);
const { Content } = await render(guide);

const sectionUrl = `${SITE.url}/books/${book.slug}/${sectionSlug(section.code)}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: SITE.url,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Books',
          item: `${SITE.url}/books`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: book.title,
          item: `${SITE.url}/books/${book.slug}`,
        },
        {
          '@type': 'ListItem',
          position: 4,
          name: `Section ${section.code}: ${section.title}`,
          item: sectionUrl,
        },
      ],
    },
    {
      '@type': ['TechArticle', 'LearningResource'],
      '@id': `${sectionUrl}#article`,
      headline: `${section.code} ${section.title} — Study Guide`,
      description: guide.data.summary,
      url: sectionUrl,
      inLanguage: 'en',
      learningResourceType: 'Study Guide',
      educationalLevel: book.level,
      about: book.subjects,
      author: {
        '@type': 'Organization',
        name: SITE.name,
        url: SITE.url,
      },
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        url: SITE.url,
        logo: `${SITE.url}/favicon.svg`,
      },
      isPartOf: {
        '@type': 'Book',
        name: book.title,
        author: { '@type': 'Person', name: book.author },
        url: `${SITE.url}/books/${book.slug}`,
      },
    },
  ],
};
---

<BaseLayout
  title={`${section.code} ${section.title}`}
  description={guide.data.summary}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="u-page guide">
    <header class="guide__head">
      <nav class="bookhead__crumb" aria-label="Breadcrumb">
        <a href="/">Books</a>
        <span aria-hidden="true">/</span>
        <a href={`/books/${book.slug}`}>{book.title}</a>
        <span aria-hidden="true">/</span>
        <span>{section.code}</span>
      </nav>

      <p class="guide__part">
        Part {part.id}. {part.title}
      </p>
      <h1 class="guide__title">
        <span class="guide__code" aria-hidden="true">{section.code}</span>
        {section.title}
      </h1>
      <p class="guide__summary">{guide.data.summary}</p>
    </header>

    <div class="guide__body">
      <div class="prose">
        <Content />
      </div>

      {/* The sources sit beside the guide on wide viewports and above it on
          narrow ones, so the reader can open the lecture while reading. */}
      <aside class="guide__aside" aria-labelledby="sources-heading">
        <h2 class="u-label" id="sources-heading">Read and watch</h2>
        <ul class="guide__sources">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                  data-free={link.variant === 'free' ? '' : undefined}
                >
                  {link.label}
                  <span class="u-sr">, opens in a new tab</span>
                </a>
                {link.detail && <span>{link.detail}</span>}
              </li>
            ))
          }
        </ul>
        <a
          class="guide__back"
          href={`/books/${book.slug}#${sectionAnchor(section.code)}`}
        >
          Back to the roadmap
        </a>
      </aside>
    </div>

    <nav class="guide__pager" aria-label="Study guides">
      {
        prev ? (
          <a class="guide__pagerlink" href={sectionHref(book.slug, prev.data.section)}>
            <span class="guide__pagerdir">Previous guide</span>
            <span class="guide__pagername">
              <span class="guide__pagercode">{prev.data.section}</span>
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a
            class="guide__pagerlink guide__pagerlink--next"
            href={sectionHref(book.slug, next.data.section)}
          >
            <span class="guide__pagerdir">Next guide</span>
            <span class="guide__pagername">
              <span class="guide__pagercode">{next.data.section}</span>
              {next.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>
