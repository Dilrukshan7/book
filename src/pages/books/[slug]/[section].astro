---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  findSection,
  resolveSectionLinks,
  sectionAnchor,
  sectionCodes,
  sectionHref,
  sectionSlug,
} from '../../../lib/books';
import { getCurrentUser } from '../../../lib/auth';
import { checkBookAccess } from '../../../lib/access';
import { listPlansForBook, seedDefaultPlansIfMissing } from '../../../lib/subscriptions';
import PoweredByPassyn from '../../../components/PoweredByPassyn.astro';
import { SITE } from '../../../site.config';
import '../../../styles/guide.css';
import '../../../styles/subscriptions.css';

export const prerender = false;

const { slug, section: sectionParam } = Astro.params;

const books = await getCollection('books');
const bookEntry = books.find((b) => b.data.slug === slug || b.id === slug);
if (!bookEntry || bookEntry.data.status !== 'available') {
  return Astro.redirect('/404');
}

const book = bookEntry.data;
const order = sectionCodes(book);

const allGuides = await getCollection('guides');
const bookGuides = allGuides
  .filter((g) => g.id.startsWith(`${bookEntry.id}/`))
  .sort(
    (a, b) =>
      order.indexOf(a.data.section) - order.indexOf(b.data.section),
  );

const guideIndex = bookGuides.findIndex((g) => {
  const found = findSection(book, g.data.section);
  return found && sectionSlug(found.section.code) === sectionParam;
});

if (guideIndex === -1) {
  return Astro.redirect('/404');
}

const guide = bookGuides[guideIndex];
const prev = bookGuides[guideIndex - 1] ?? null;
const next = bookGuides[guideIndex + 1] ?? null;

const found = findSection(book, guide.data.section)!;
const { section, part } = found;
const links = resolveSectionLinks(book, section);
const { Content } = await render(guide);

// BACKEND-ENFORCED SUBSCRIPTION ACCESS CHECK
await seedDefaultPlansIfMissing();
const user = getCurrentUser(Astro.request);
const accessCheck = await checkBookAccess(user, book.slug);
const plans = listPlansForBook(book.slug);

const sectionUrl = `${SITE.url}/books/${book.slug}/${sectionSlug(section.code)}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: SITE.url,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Books',
          item: `${SITE.url}/books`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: book.title,
          item: `${SITE.url}/books/${book.slug}`,
        },
        {
          '@type': 'ListItem',
          position: 4,
          name: `Section ${section.code}: ${section.title}`,
          item: sectionUrl,
        },
      ],
    },
    {
      '@type': ['TechArticle', 'LearningResource'],
      '@id': `${sectionUrl}#article`,
      headline: `${section.code} ${section.title} — Study Guide`,
      description: guide.data.summary,
      url: sectionUrl,
      inLanguage: 'en',
      learningResourceType: 'Study Guide',
      educationalLevel: book.level,
      about: book.subjects,
      author: {
        '@type': 'Organization',
        name: SITE.name,
        url: SITE.url,
      },
      publisher: {
        '@type': 'Organization',
        name: SITE.name,
        url: SITE.url,
        logo: `${SITE.url}/favicon.svg`,
      },
      isPartOf: {
        '@type': 'Book',
        name: book.title,
        author: { '@type': 'Person', name: book.author },
        url: `${SITE.url}/books/${book.slug}`,
      },
    },
  ],
};
---

<BaseLayout
  title={`${section.code} ${section.title}`}
  description={guide.data.summary}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="u-page guide">
    <header class="guide__head">
      <nav class="bookhead__crumb" aria-label="Breadcrumb">
        <a href="/">Books</a>
        <span aria-hidden="true">/</span>
        <a href={`/books/${book.slug}`}>{book.title}</a>
        <span aria-hidden="true">/</span>
        <span>{section.code}</span>
      </nav>

      <p class="guide__part">
        Part {part.id}. {part.title}
      </p>
      <h1 class="guide__title">
        <span class="guide__code" aria-hidden="true">{section.code}</span>
        {section.title}
      </h1>
      <p class="guide__summary">{guide.data.summary}</p>
    </header>

    <div class="guide__body">
      {
        accessCheck.hasAccess ? (
          <div class="prose">
            <Content />
          </div>
        ) : (
          <div class="paywall-block" style="margin-top: 0;">
            <div class="paywall-block__header">
              <span class="paywall-block__tag">Study Guide</span>
              <h2 class="paywall-block__title">
                Study Pass Required
              </h2>
              <p class="paywall-block__lead">
                This study guide for <strong>{section.code}: {section.title}</strong> is available with an active reading pass. Choose an access window below:
              </p>
            </div>

            <div class="pass-ledger" style="margin-bottom: var(--s-4, 1rem);">
              <div class="pass-ledger__head">
                <span>Duration</span>
                <span>Pass Scope</span>
                <span>Price</span>
                <span style="text-align: right;">Action</span>
              </div>
              <div class="pass-ledger__rows">
                {plans.map((p, idx) => {
                  const isFeatured = idx === 1;
                  const periodLabel = p.duration_hours >= 720 ? '30 Days' : p.duration_hours >= 168 ? '7 Days' : `${p.duration_hours} Hours`;
                  return (
                    <div class={`pass-row plan-card ${idx === 1 ? 'plan-card--featured pass-row--featured' : ''}`}>
                      <div class="pass-row__main">
                        <span class={`pass-row__tag ${isFeatured ? 'pass-row__tag--popular' : ''}`}>
                          {periodLabel}
                        </span>
                        <h3 class="pass-row__name">{p.name}</h3>
                      </div>
                      <div class="pass-row__desc">{p.description}</div>
                      <div class="pass-row__price">
                        <span class="pass-row__amount">${p.price.toFixed(2)}</span>
                        <span class="pass-row__cur">{p.currency}</span>
                      </div>
                      <div class="pass-row__action">
                        {user ? (
                          <button
                            type="button"
                            class="btn-sub purchase-pass-btn"
                            data-plan-id={p.id}
                            data-book-slug={book.slug}
                          >
                            Get Pass
                          </button>
                        ) : (
                          <a
                            href={`/auth/login?redirect=${encodeURIComponent(Astro.url.pathname)}`}
                            class="btn-sub btn-sub--secondary"
                          >
                            Sign In
                          </a>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>

            <div class="paywall-block__footer">
              <div style="font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-3);">
                {accessCheck.reason === 'EXPIRED' && (
                  <span style="color: var(--accent);">Your previous pass has expired.</span>
                )}
                {accessCheck.reason === 'REVOKED' && (
                  <span style="color: var(--accent);">Your previous pass was revoked or cancelled.</span>
                )}
                {!accessCheck.reason && (
                  <span>Passes run for their full time window with no automatic renewals.</span>
                )}
              </div>
              <PoweredByPassyn />
            </div>
          </div>
        )
      }

      {/* The sources sit beside the guide on wide viewports and above it on
          narrow ones, so the reader can open the lecture while reading. */}
      <aside class="guide__aside" aria-labelledby="sources-heading">
        <h2 class="u-label" id="sources-heading">Read and watch</h2>
        <ul class="guide__sources">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                  data-free={link.variant === 'free' ? '' : undefined}
                >
                  {link.label}
                  <span class="u-sr">, opens in a new tab</span>
                </a>
                {link.detail && <span>{link.detail}</span>}
              </li>
            ))
          }
        </ul>
        <a
          class="guide__back"
          href={`/books/${book.slug}#${sectionAnchor(section.code)}`}
        >
          Back to the roadmap
        </a>
      </aside>
    </div>

    <nav class="guide__pager" aria-label="Study guides">
      {
        prev ? (
          <a class="guide__pagerlink" href={sectionHref(book.slug, prev.data.section)}>
            <span class="guide__pagerdir">Previous guide</span>
            <span class="guide__pagername">
              <span class="guide__pagercode">{prev.data.section}</span>
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a
            class="guide__pagerlink guide__pagerlink--next"
            href={sectionHref(book.slug, next.data.section)}
          >
            <span class="guide__pagerdir">Next guide</span>
            <span class="guide__pagername">
              <span class="guide__pagercode">{next.data.section}</span>
              {next.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  <script is:inline>
    document.querySelectorAll('.purchase-pass-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const planId = btn.getAttribute('data-plan-id');
        const bookSlug = btn.getAttribute('data-book-slug');

        btn.disabled = true;
        btn.textContent = 'Activating pass...';

        try {
          const res = await fetch('/api/subscriptions/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ planId, bookSlug }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert(data.error?.message || 'Subscription activation failed');
            btn.disabled = false;
            btn.textContent = 'Get Pass';
          }
        } catch {
          alert('Network error. Please try again.');
          btn.disabled = false;
          btn.textContent = 'Get Pass';
        }
      });
    });
  </script>
</BaseLayout>
