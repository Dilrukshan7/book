---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCatalog from '../../components/BookCatalog.astro';
import AiGuideGenerator from '../../components/AiGuideGenerator.astro';
import { SITE } from '../../site.config';

const entries = await getCollection('books');
const books = entries
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

const available = books.filter((b) => b.status === 'available');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Technical Books & Roadmaps \u2014 ${SITE.name}`,
  description: 'Explore structured, section-by-section reading roadmaps for advanced technical books with free lectures and problem sets.',
  url: `${SITE.url}/books`,
  hasPart: available.map((book) => ({
    '@type': 'Book',
    name: book.title,
    author: { '@type': 'Person', name: book.author },
    url: `${SITE.url}/books/${book.slug}`,
  })),
};
---

<BaseLayout
  title={`Technical Books & Roadmaps \u2014 ${SITE.name}`}
  description="Explore structured, section-by-section reading roadmaps for advanced technical books with free lectures and problem sets."
  suffix={false}
  jsonLd={jsonLd}
>
  <div class="u-page" style="padding-top: var(--s-8); padding-bottom: var(--s-10);">
    <header class="page-head" style="margin-bottom: var(--s-7);">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: var(--s-4);">
        <div>
          <nav class="bookhead__crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <span>Books Library</span>
          </nav>

          <h1 class="u-h1">Technical Books &amp; Roadmaps</h1>
          <p class="page-head__lead">
            Structured step-by-step paths through hard textbooks, with lectures, sample chapters, and problem sets published free by their authors.
          </p>
        </div>

        <div>
          <AiGuideGenerator />
        </div>
      </div>
    </header>

    <BookCatalog books={available} />
  </div>
</BaseLayout>
