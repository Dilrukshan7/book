---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PartSection from '../../components/PartSection.astro';
import FreeMaterialFigure from '../../components/FreeMaterialFigure.astro';
import {
  assertGuidesResolve,
  sectionAnchor,
  totalSections,
} from '../../lib/books';
import { SITE } from '../../site.config';
import '../../styles/roadmap.css';
import '../../styles/charts.css';

export async function getStaticPaths() {
  const books = await getCollection('books');
  const guides = await getCollection('guides');
  const guideIds = guides.map((g) => g.id);

  return books
    .filter((entry) => entry.data.status === 'available')
    .map((entry) => {
      // The directory name is the route, so a mismatch with the declared
      // slug would silently publish the book at an unexpected URL.
      if (entry.id !== entry.data.slug) {
        throw new Error(
          `Book directory "src/content/books/${entry.id}" declares ` +
            `slug "${entry.data.slug}". The directory name and the slug must ` +
            'match, because the directory name is what routes the page.',
        );
      }
      assertGuidesResolve(entry.data, entry.id, guideIds);
      return { params: { slug: entry.data.slug }, props: { entry } };
    });
}

const { entry } = Astro.props;
const book = entry.data;

const guides = await getCollection('guides', (g) =>
  g.id.startsWith(`${entry.id}/`),
);
const guidedCodes = new Set(guides.map((g) => g.data.section));

const sections = totalSections(book);
const firstCode = book.parts[0]?.sections[0]?.code ?? '';
const firstTitle = book.parts[0]?.sections[0]?.title ?? '';

const kindLabel: Record<string, string> = {
  pdf: 'PDF',
  video: 'Video',
  playlist: 'Playlist',
  page: 'Page',
  solutions: 'Solutions',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: SITE.url,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Books',
          item: `${SITE.url}/books`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: book.title,
          item: `${SITE.url}/books/${book.slug}`,
        },
      ],
    },
    {
      '@type': 'Book',
      '@id': `${SITE.url}/books/${book.slug}#book`,
      name: book.title,
      description:
        book.tagline ||
        `A free, ordered reading roadmap for ${book.title} by ${book.author}.`,
      author: {
        '@type': 'Person',
        name: book.author,
      },
      datePublished: String(book.year),
      publisher: book.publisher
        ? { '@type': 'Organization', name: book.publisher }
        : undefined,
      isbn: book.isbn,
      inLanguage: 'en',
      about: book.subjects,
      educationalLevel: book.level,
      url: `${SITE.url}/books/${book.slug}`,
      sameAs: book.officialPage,
      isPartOf: {
        '@type': 'WebSite',
        name: SITE.name,
        url: SITE.url,
      },
    },
  ],
};
---

<BaseLayout
  title={book.title}
  description={`A free, ordered reading roadmap for ${book.title} by ${book.author}. All ${sections} sections, each linked to the material published free for it.`}
  ogType="book"
  jsonLd={jsonLd}
>
  <div class="u-page">
    <div class="bookhead">
      <nav class="bookhead__crumb" aria-label="Breadcrumb">
        <a href="/">Books</a>
        <span aria-hidden="true">/</span>
        <span>{book.title}</span>
      </nav>

      <div class="bookhead__grid">
        <h1 class="bookhead__title">{book.title}</h1>
        <div>
          <p class="bookhead__blurb">{book.tagline}</p>
          <p class="bookhead__byline">
            <strong>{book.author}</strong>, {book.year}{
              book.publisher ? `. ${book.publisher}` : ''
            }
          </p>
        </div>
      </div>
    </div>

    {/* Everything the tracker touches lives inside this root. */}
    <div class="book" data-tracker data-book-slug={book.slug}>
      <aside class="rail" aria-label="Contents and progress">
        <div class="rail__strip">
          <div class="rail__section">
            <p
              class="gauge__figure"
              data-progressbar
              role="progressbar"
              aria-label="Reading progress"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
            >
              <span class="gauge__done" data-gauge-done>0</span>
              <span class="gauge__total" data-gauge-total>/ {sections}</span>
            </p>
            <div class="gauge__track" aria-hidden="true">
              <span class="gauge__fill" data-gauge-fill></span>
            </div>
            <p class="gauge__caption" data-gauge-caption>0% of the book</p>
            <p class="gauge__streak" data-gauge-streak hidden>
              <b data-gauge-streak-value>0</b>
              <span data-gauge-streak-unit>days</span> in a row
            </p>
          </div>

          {/* Rendered pointing at the first section so it works with no
              JavaScript; the tracker retargets it to the next unread one. */}
          <div class="rail__section">
            <a class="resume" href={`#${sectionAnchor(firstCode)}`} data-resume>
              <span class="resume__label" aria-hidden="true">
                <span data-resume-label>Start</span>
                <span class="resume__arrow">&#8594;</span>
              </span>
              <span class="resume__target" aria-hidden="true">
                <span class="resume__code" data-resume-code>{firstCode}</span>
                <span data-resume-title>{firstTitle}</span>
              </span>
              <span class="u-sr" data-resume-sr>
                Start reading at section {firstCode}, {firstTitle}
              </span>
            </a>
          </div>
        </div>

        <div class="rail__jump">
          <label class="u-sr" for="jump">Jump to a part</label>
          <select id="jump" data-jump>
            <option value="">Jump to a part</option>
            {
              book.parts.map((part) => (
                <option value={`part-${part.id}`}>
                  {part.id}. {part.title}
                </option>
              ))
            }
          </select>
        </div>

        <nav class="rail__section railnav" aria-label="Parts">
          {
            book.parts.map((part) => (
              <a href={`#part-${part.id}`} data-railnav-part={part.id}>
                <span class="railnav__roman" aria-hidden="true">
                  {part.id}
                </span>
                <span>{part.title}</span>
                <span class="railnav__count" data-railnav-count>
                  0/{part.sections.length}
                </span>
                <span class="barlist__track" aria-hidden="true">
                  <span class="barlist__fill" data-railnav-fill></span>
                </span>
              </a>
            ))
          }
        </nav>

        <details class="rail__section tools">
          <summary>Progress tools</summary>
          <div class="tools__body">
            <button type="button" class="btn--quiet" data-action="export">
              Export progress
            </button>
            <button type="button" class="btn--quiet" data-action="import">
              Import progress
            </button>
            <button type="button" class="btn--quiet" data-action="reset">
              Reset this book
            </button>
            <input
              type="file"
              accept="application/json,.json"
              data-import-input
              class="u-sr"
              tabindex="-1"
              aria-hidden="true"
            />
          </div>
          <p class="tools__note">
            Progress is kept in this browser only. Export and import move it
            between devices; there is no account.
          </p>
        </details>
      </aside>

      <div class="main">
        <p class="notice">
          <span class="notice__title">What is actually free</span>
          {book.accessNotice}
        </p>

        <div class="freefig">
          <FreeMaterialFigure book={book} />
        </div>

        <div class="parts">
          {
            book.parts.map((part) => (
              <PartSection
                book={book}
                bookSlug={book.slug}
                part={part}
                guidedCodes={guidedCodes}
              />
            ))
          }
        </div>

        {
          book.resources.length > 0 && (
            <section class="sources" aria-labelledby="sources-heading">
              <h2 class="u-label" id="sources-heading">
                Material for the whole book
              </h2>
              <div class="sources__grid">
                {book.resources.map((resource) => (
                  <p class="sources__item">
                    <a href={resource.url} target="_blank" rel="noopener">
                      {resource.label}
                      <span class="u-sr">
                        , from {resource.source}, opens in a new tab
                      </span>
                    </a>
                    <span class="sources__kind" aria-hidden="true">
                      {kindLabel[resource.kind] ?? resource.kind}
                    </span>
                  </p>
                ))}
              </div>
            </section>
          )
        }

        <section class="attrib" aria-labelledby="attrib-heading">
          <h2 class="u-label" id="attrib-heading">Attribution</h2>
          <p>
            <em>{book.title}</em> is copyright {book.year} {book.author}{
              book.publisher ? `, published by ${book.publisher}` : ''
            }. This page is an independent reading guide. It reproduces no part
            of the book and hosts no files: every link above points to{' '}
            <a href={book.officialPage} target="_blank" rel="noopener"
              >the author's own page</a
            > or to the publishing university's servers.
          </p>
          {
            book.course && (
              <p>
                Lecture and problem links go to{' '}
                <a href={book.course.url} target="_blank" rel="noopener">
                  {book.course.name}
                </a>
                {book.course.license && (
                  <>
                    , used under{' '}
                    {book.course.licenseUrl ? (
                      <a
                        href={book.course.licenseUrl}
                        target="_blank"
                        rel="noopener"
                      >
                        {book.course.license}
                      </a>
                    ) : (
                      book.course.license
                    )}
                  </>
                )}
                .
              </p>
            )
          }
          {
            book.buyUrl && (
              <p>
                If this book is useful to you and you can afford it,{' '}
                <a href={book.buyUrl} target="_blank" rel="noopener">
                  buy a copy
                </a>
                . That is what keeps authors writing them.
              </p>
            )
          }
        </section>
      </div>

      <div class="toast" data-toast role="status" aria-live="polite"></div>
    </div>
  </div>
</BaseLayout>

<script>
  import { initTracker } from '../../lib/tracker';

  const root = document.querySelector<HTMLElement>('[data-tracker]');
  if (root) initTracker(root);
</script>
