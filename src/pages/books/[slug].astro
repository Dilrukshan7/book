---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PartSection from '../../components/PartSection.astro';
import FreeMaterialFigure from '../../components/FreeMaterialFigure.astro';
import {
  assertGuidesResolve,
  sectionAnchor,
  totalSections,
} from '../../lib/books';
import { getCurrentUser } from '../../lib/auth';
import { listPlansForBook, getUserActiveSubscription, seedDefaultPlansIfMissing } from '../../lib/subscriptions';
import PoweredByPassyn from '../../components/PoweredByPassyn.astro';
import { SITE } from '../../site.config';
import '../../styles/roadmap.css';
import '../../styles/charts.css';
import '../../styles/subscriptions.css';

export const prerender = false;

const { slug } = Astro.params;
const books = await getCollection('books');
const entry = books.find((b) => b.data.slug === slug || b.id === slug);

if (!entry || entry.data.status !== 'available') {
  return Astro.redirect('/404');
}

const guidesAll = await getCollection('guides');
const guideIds = guidesAll.map((g) => g.id);
assertGuidesResolve(entry.data, entry.id, guideIds);

const book = entry.data;

let user: any = null;
let plans: any[] = [];
let activeSub: any = null;

try {
  await seedDefaultPlansIfMissing();
} catch (e) {
  console.warn('Seed notice:', e);
}

try {
  user = await getCurrentUser(Astro.request);
} catch (e) {
  console.warn('Auth notice:', e);
}

try {
  plans = await listPlansForBook(book.slug);
} catch (e) {
  console.warn('Plans notice:', e);
}

try {
  if (user) {
    activeSub = await getUserActiveSubscription(user.id, book.slug);
  }
} catch (e) {
  console.warn('Active sub notice:', e);
}

const guides = await getCollection('guides', (g) =>
  g.id.startsWith(`${entry.id}/`),
);
const guidedCodes = new Set(guides.map((g) => g.data.section));

const sections = totalSections(book);
const firstCode = book.parts[0]?.sections[0]?.code ?? '';
const firstTitle = book.parts[0]?.sections[0]?.title ?? '';

const kindLabel: Record<string, string> = {
  pdf: 'PDF',
  video: 'Video',
  playlist: 'Playlist',
  page: 'Page',
  solutions: 'Solutions',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: SITE.url,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Books',
          item: `${SITE.url}/books`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: book.title,
          item: `${SITE.url}/books/${book.slug}`,
        },
      ],
    },
    {
      '@type': 'Book',
      '@id': `${SITE.url}/books/${book.slug}#book`,
      name: book.title,
      description:
        book.tagline ||
        `A free, ordered reading roadmap for ${book.title} by ${book.author}.`,
      author: {
        '@type': 'Person',
        name: book.author,
      },
      datePublished: String(book.year),
      publisher: book.publisher
        ? { '@type': 'Organization', name: book.publisher }
        : undefined,
      isbn: book.isbn,
      inLanguage: 'en',
      about: book.subjects,
      educationalLevel: book.level,
      url: `${SITE.url}/books/${book.slug}`,
      sameAs: book.officialPage,
      isPartOf: {
        '@type': 'WebSite',
        name: SITE.name,
        url: SITE.url,
      },
    },
  ],
};
---

<BaseLayout
  title={book.title}
  description={`A free, ordered reading roadmap for ${book.title} by ${book.author}. All ${sections} sections, each linked to the material published free for it.`}
  ogType="book"
  jsonLd={jsonLd}
>
  <div class="u-page">
    <div class="bookhead">
      <nav class="bookhead__crumb" aria-label="Breadcrumb">
        <a href="/">Books</a>
        <span aria-hidden="true">/</span>
        <span>{book.title}</span>
      </nav>

      <div class="bookhead__grid">
        <h1 class="bookhead__title">{book.title}</h1>
        <div>
          <p class="bookhead__blurb">{book.tagline}</p>
          <p class="bookhead__byline">
            <strong>{book.author}</strong>, {book.year}{
              book.publisher ? `. ${book.publisher}` : ''
            }
          </p>
        </div>
      </div>
    </div>

    {/* Everything the tracker touches lives inside this root. */}
    <div class="book" data-tracker data-book-slug={book.slug}>
      <aside class="rail" aria-label="Contents and progress">
        <div class="rail__strip">
          <div class="rail__section">
            <p
              class="gauge__figure"
              data-progressbar
              role="progressbar"
              aria-label="Reading progress"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
            >
              <span class="gauge__done" data-gauge-done>0</span>
              <span class="gauge__total" data-gauge-total>/ {sections}</span>
            </p>
            <div class="gauge__track" aria-hidden="true">
              <span class="gauge__fill" data-gauge-fill></span>
            </div>
            <p class="gauge__caption" data-gauge-caption>0% of the book</p>
            <p class="gauge__streak" data-gauge-streak hidden>
              <b data-gauge-streak-value>0</b>
              <span data-gauge-streak-unit>days</span> in a row
            </p>
          </div>

          {/* Rendered pointing at the first section so it works with no
              JavaScript; the tracker retargets it to the next unread one. */}
          <div class="rail__section">
            <a class="resume" href={`#${sectionAnchor(firstCode)}`} data-resume>
              <span class="resume__label" aria-hidden="true">
                <span data-resume-label>Start</span>
                <span class="resume__arrow">&#8594;</span>
              </span>
              <span class="resume__target" aria-hidden="true">
                <span class="resume__code" data-resume-code>{firstCode}</span>
                <span data-resume-title>{firstTitle}</span>
              </span>
              <span class="u-sr" data-resume-sr>
                Start reading at section {firstCode}, {firstTitle}
              </span>
            </a>
          </div>
        </div>

        <div class="rail__jump">
          <label class="u-sr" for="jump">Jump to a part</label>
          <select id="jump" data-jump>
            <option value="">Jump to a part</option>
            {
              book.parts.map((part) => (
                <option value={`part-${part.id}`}>
                  {part.id}. {part.title}
                </option>
              ))
            }
          </select>
        </div>

        <nav class="rail__section railnav" aria-label="Parts">
          {
            book.parts.map((part) => (
              <a href={`#part-${part.id}`} data-railnav-part={part.id}>
                <span class="railnav__roman" aria-hidden="true">
                  {part.id}
                </span>
                <span>{part.title}</span>
                <span class="railnav__count" data-railnav-count>
                  0/{part.sections.length}
                </span>
                <span class="barlist__track" aria-hidden="true">
                  <span class="barlist__fill" data-railnav-fill></span>
                </span>
              </a>
            ))
          }
        </nav>

        <details class="rail__section tools">
          <summary>Progress tools</summary>
          <div class="tools__body">
            <button type="button" class="btn--quiet" data-action="export">
              Export progress
            </button>
            <button type="button" class="btn--quiet" data-action="import">
              Import progress
            </button>
            <button type="button" class="btn--quiet" data-action="reset">
              Reset this book
            </button>
            <input
              type="file"
              accept="application/json,.json"
              data-import-input
              class="u-sr"
              tabindex="-1"
              aria-hidden="true"
            />
          </div>
          <p class="tools__note">
            Progress is kept in this browser only. Export and import move it
            between devices; there is no account.
          </p>
        </details>
      </aside>

      <div class="main">
        <p class="notice">
          <span class="notice__title">What is actually free</span>
          {book.accessNotice}
        </p>

        <div class="freefig">
          <FreeMaterialFigure book={book} />
        </div>

        <!-- Minimalist Study Passes Section -->
        <section class="book-subscriptions" style="margin: var(--space-8) 0; border-top: 1px solid var(--rule); padding-top: var(--space-6);">
          <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4);">
            <div>
              <span class="sub-header__eyebrow" style="font-size: 11px;">Study Guides</span>
              <h2 style="font-family: var(--font-serif); font-size: var(--step-2); font-weight: 600; color: var(--ink); margin: 0;">
                Reading Passes
              </h2>
            </div>
            <p style="font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-3);">
              {activeSub ? '✓ Active Pass Enabled' : 'Unlock chapter study guides, video lecture breakdowns, and milestones.'}
            </p>
          </div>

          {activeSub ? (
            <div style="background: var(--paper-raised); border: 1px solid var(--rule); border-left: 3px solid var(--status-complete); border-radius: 4px; padding: var(--space-5) var(--space-6); margin-bottom: var(--space-6);">
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-4);">
                <div>
                  <span class="badge badge--active" style="margin-bottom: var(--space-1);">Pass Active</span>
                  <h3 style="font-family: var(--font-serif); font-size: var(--step-1); font-weight: 600; color: var(--ink); margin: var(--space-1) 0;">
                    {activeSub.plan_name}
                  </h3>
                  <p style="font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-3);">
                    Full access to all protected study guides until <strong>{activeSub.expires_at ? new Date(activeSub.expires_at).toLocaleString() : 'expiry'}</strong>.
                  </p>
                </div>
                <a href="/account/subscriptions" class="btn-sub btn-sub--secondary" style="width: auto; padding: var(--space-1) var(--space-3); font-size: var(--step--1);">
                  Manage in Dashboard
                </a>
              </div>
            </div>
          ) : (
            <div class="pass-ledger">
              <div class="pass-ledger__head">
                <span>Duration</span>
                <span>Access Details</span>
                <span>Price</span>
                <span style="text-align: right;">Action</span>
              </div>
              <div class="pass-ledger__rows">
                {plans.map((p, idx) => {
                  const isFeatured = idx === 1;
                  const periodLabel = p.duration_hours >= 720 ? '30 Days' : p.duration_hours >= 168 ? '7 Days' : `${p.duration_hours} Hours`;
                  return (
                    <div class={`pass-row plan-card ${isFeatured ? 'plan-card--featured pass-row--featured' : ''}`}>
                      <div class="pass-row__main">
                        <span class={`pass-row__tag ${isFeatured ? 'pass-row__tag--popular' : ''}`}>
                          {periodLabel}
                        </span>
                        <h3 class="pass-row__name">{p.name}</h3>
                      </div>
                      <div class="pass-row__desc">
                        {p.description || 'Full unmetered access to study guides and roadmaps.'}
                      </div>
                      <div class="pass-row__price">
                        <span class="pass-row__amount">${p.price.toFixed(2)}</span>
                        <span class="pass-row__cur">{p.currency}</span>
                      </div>
                      <div class="pass-row__action">
                        {user ? (
                          <button
                            type="button"
                            class="btn-sub purchase-pass-btn"
                            data-plan-id={p.id}
                            data-book-slug={book.slug}
                          >
                            Get Pass
                          </button>
                        ) : (
                          <a
                            href={`/auth/login?redirect=${encodeURIComponent(`/books/${book.slug}`)}`}
                            class="btn-sub btn-sub--secondary"
                          >
                            Sign In
                          </a>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
              <div class="pass-ledger__foot">
                <span>Instant access &middot; Self-service cancellation anytime</span>
                <PoweredByPassyn />
              </div>
            </div>
          )}
        </section>

        <div class="parts">
          {
            book.parts.map((part) => (
              <PartSection
                book={book}
                bookSlug={book.slug}
                part={part}
                guidedCodes={guidedCodes}
              />
            ))
          }
        </div>

        {
          book.resources.length > 0 && (
            <section class="sources" aria-labelledby="sources-heading">
              <h2 class="u-label" id="sources-heading">
                Material for the whole book
              </h2>
              <div class="sources__grid">
                {book.resources.map((resource) => (
                  <p class="sources__item">
                    <a href={resource.url} target="_blank" rel="noopener">
                      {resource.label}
                      <span class="u-sr">
                        , from {resource.source}, opens in a new tab
                      </span>
                    </a>
                    <span class="sources__kind" aria-hidden="true">
                      {kindLabel[resource.kind] ?? resource.kind}
                    </span>
                  </p>
                ))}
              </div>
            </section>
          )
        }

        <section class="attrib" aria-labelledby="attrib-heading">
          <h2 class="u-label" id="attrib-heading">Attribution</h2>
          <p>
            <em>{book.title}</em> is copyright {book.year} {book.author}{
              book.publisher ? `, published by ${book.publisher}` : ''
            }. This page is an independent reading guide. It reproduces no part
            of the book and hosts no files: every link above points to{' '}
            <a href={book.officialPage} target="_blank" rel="noopener"
              >the author's own page</a
            > or to the publishing university's servers.
          </p>
          {
            book.course && (
              <p>
                Lecture and problem links go to{' '}
                <a href={book.course.url} target="_blank" rel="noopener">
                  {book.course.name}
                </a>
                {book.course.license && (
                  <>
                    , used under{' '}
                    {book.course.licenseUrl ? (
                      <a
                        href={book.course.licenseUrl}
                        target="_blank"
                        rel="noopener"
                      >
                        {book.course.license}
                      </a>
                    ) : (
                      book.course.license
                    )}
                  </>
                )}
                .
              </p>
            )
          }
          {
            book.buyUrl && (
              <p>
                If this book is useful to you and you can afford it,{' '}
                <a href={book.buyUrl} target="_blank" rel="noopener">
                  buy a copy
                </a>
                . That is what keeps authors writing them.
              </p>
            )
          }
        </section>
      </div>

      <div class="toast" data-toast role="status" aria-live="polite"></div>
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('.purchase-pass-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const planId = btn.getAttribute('data-plan-id');
        const bookSlug = btn.getAttribute('data-book-slug');

        btn.disabled = true;
        btn.textContent = 'Activating pass...';

        try {
          const res = await fetch('/api/subscriptions/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ planId, bookSlug }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert(data.error?.message || 'Subscription activation failed');
            btn.disabled = false;
            btn.textContent = 'Get Pass';
          }
        } catch {
          alert('Network error. Please try again.');
          btn.disabled = false;
          btn.textContent = 'Get Pass';
        }
      });
    });
  </script>
</BaseLayout>

<script>
  import { initTracker } from '../../lib/tracker';

  const root = document.querySelector<HTMLElement>('[data-tracker]');
  if (root) initTracker(root);
</script>
