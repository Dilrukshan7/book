---
import type { Book, Part } from '../lib/books';
import { checklistKey } from '../lib/books';
import SectionRow from './SectionRow.astro';

interface Props {
  book: Book;
  bookSlug: string;
  part: Part;
  /** Section codes that have a study guide page. */
  guidedCodes: ReadonlySet<string>;
}

const { book, bookSlug, part, guidedCodes } = Astro.props;
const total = part.sections.length;
---

{/*
  Parts are open by default rather than collapsed. The old accordion hid the
  contents behind seven clicks and made the page unsearchable with ctrl-F;
  navigation is handled by the sticky rail instead.
*/}
<section class="part" id={`part-${part.id}`} data-part data-part-id={part.id}>
  <header class="part__head">
    <span class="part__roman" aria-hidden="true">{part.id}</span>
    <div>
      <h2 class="part__title">{part.title}</h2>
      {part.summary && <p class="part__summary">{part.summary}</p>}
    </div>
    <p class="part__count">
      <span class="u-sr">Part {part.id} progress: </span>
      <span data-part-count>0/{total}</span>
      <span class="u-sr"> sections read</span>
    </p>
  </header>

  <ul class="sections">
    {
      part.sections.map((section) => (
        <SectionRow
          book={book}
          bookSlug={bookSlug}
          section={section}
          hasGuide={guidedCodes.has(section.code)}
        />
      ))
    }
  </ul>

  {
    part.checklist.length > 0 && (
      <div class="checklist">
        <h3 class="checklist__title">Before moving on from Part {part.id}</h3>
        <ul class="checklist__items">
          {part.checklist.map((task, index) => {
            const key = checklistKey(part.id, index);
            const id = `cl-${bookSlug}-${key}`;
            return (
              <li class="checklist__item">
                <input type="checkbox" id={id} data-checklist data-key={key} />
                <label for={id}>{task}</label>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</section>
