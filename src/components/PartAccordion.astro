---
import type { Book, Part } from '../lib/books';
import { checklistKey } from '../lib/books';
import SectionRow from './SectionRow.astro';

interface Props {
  book: Book;
  bookSlug: string;
  part: Part;
  /** Section codes that have a study guide page. */
  guidedCodes: ReadonlySet<string>;
  /** The first part is open on load so the page never looks empty. */
  open: boolean;
}

const { book, bookSlug, part, guidedCodes, open } = Astro.props;
const total = part.sections.length;
---

<details class="part" id={`part-${part.id}`} data-part data-part-id={part.id} open={open}>
  <summary class="part__summary">
    <div class="part__title-block">
      <span class="part__badge" data-part-badge={part.id} aria-hidden="true">
        {part.id}
      </span>
      <div class="part__titles">
        <h2>Part {part.id} — {part.title}</h2>
        {part.summary && <p class="part__sub">{part.summary}</p>}
      </div>
    </div>

    <div class="part__progress">
      <span data-part-count>0/{total}</span>
      <span class="minibar" aria-hidden="true">
        <span class="minibar__fill" data-part-fill></span>
      </span>
      <span class="chevron" aria-hidden="true">▶</span>
    </div>
  </summary>

  <div class="part__body">
    <ul class="sections">
      {
        part.sections.map((section) => (
          <SectionRow
            book={book}
            bookSlug={bookSlug}
            section={section}
            hasGuide={guidedCodes.has(section.code)}
          />
        ))
      }
    </ul>

    {
      part.checklist.length > 0 && (
        <div class="checklist">
          <h3 class="checklist__title">Study checklist for Part {part.id}</h3>
          <ul>
            {part.checklist.map((task, index) => {
              const key = checklistKey(part.id, index);
              const id = `cl-${bookSlug}-${key}`;
              return (
                <li>
                  <input type="checkbox" id={id} data-checklist data-key={key} />
                  <label for={id}>{task}</label>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
  </div>
</details>
