---
import { getCollection } from 'astro:content';
import type { Book } from '../lib/books';
import '../styles/generator.css';

interface Props {
  books?: Book[];
}

const { books: propBooks } = Astro.props;
const entries = propBooks ? [] : await getCollection('books');
const availableBooks = propBooks || entries.map((e) => e.data);

const existingCatalog = availableBooks.map((b) => ({
  slug: b.slug,
  title: b.title,
  author: b.author,
  isbn: b.isbn ? b.isbn.replace(/[^0-9X]/gi, '') : '',
  isbnRaw: b.isbn || '',
  year: b.year,
}));
---

{/* Launcher Button */}
<button
  type="button"
  class="generator-launcher-btn"
  data-generator-trigger
  aria-haspopup="dialog"
  aria-expanded="false"
>
  <span class="generator-launcher-btn__sparkle" aria-hidden="true">&#10024;</span>
  <span>AI Roadmap Generator</span>
</button>

{/* Modal Dialog */}
<div
  class="generator-modal"
  id="ai-generator-modal"
  data-generator-modal
  data-catalog={JSON.stringify(existingCatalog)}
  role="dialog"
  aria-modal="true"
  aria-labelledby="generator-modal-title"
  hidden
>
  <div class="generator-dialog" data-generator-dialog>
    {/* Header */}
    <header class="generator-header">
      <div class="generator-header__title-group">
        <span class="badge badge--accent">Studio</span>
        <h2 class="generator-header__title" id="generator-modal-title">
          Technical Roadmap Generator
        </h2>
      </div>
      <button
        type="button"
        class="generator-header__close"
        data-generator-close
        aria-label="Close generator modal"
      >
        &times;
      </button>
    </header>

    {/* Body */}
    <div class="generator-body">
      <p class="u-text-sm" style="color: var(--ink-3); margin: 0;">
        Enter any technical textbook title, ISBN, or course name. We will first check our curated library, and if not available, our AI engine will generate a structured section-by-section roadmap for you to study on the site.
      </p>

      {/* Form */}
      <form class="generator-form" data-generator-form>
        <div class="generator-input-wrap">
          <input
            type="text"
            class="generator-input"
            placeholder="e.g. ISBN 978-0-393-97950-3, or 'Introduction to Algorithms'..."
            maxlength="250"
            required
            data-generator-input
          />
          <button type="submit" class="generator-submit" data-generator-submit>
            <span>Find or Generate</span>
            <span aria-hidden="true">&#8594;</span>
          </button>
        </div>

        {/* Quick Example Suggestions */}
        <div class="generator-suggestions">
          <span class="generator-suggestions__label">Try:</span>
          <button
            type="button"
            class="generator-chip"
            data-suggest="Introduction to Linear Algebra"
          >
            Introduction to Linear Algebra (Existing)
          </button>
          <button
            type="button"
            class="generator-chip"
            data-suggest="C Programming: A Modern Approach by K. N. King"
          >
            C Programming (K. N. King)
          </button>
          <button
            type="button"
            class="generator-chip"
            data-suggest="Introduction to Algorithms by Cormen, Leiserson, Rivest, Stein"
          >
            CLRS Algorithms
          </button>
        </div>
      </form>

      {/* Status Bar */}
      <div class="generator-status" data-generator-status hidden>
        <div class="generator-pulse" aria-hidden="true"></div>
        <span data-generator-status-text>Checking library...</span>
      </div>

      {/* Found in Curated Library Notice */}
      <div class="notice" data-generator-found hidden>
        <span class="notice__title">Curated Roadmap Available</span>
        <p data-generator-found-text></p>
        <div style="margin-top: var(--s-3);">
          <a href="#" class="btn" data-generator-found-link>
            <span>Open Curated Roadmap</span>
            <span class="btn__arrow" aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>

      {/* Error Notice */}
      <div class="notice notice--alert" data-generator-error hidden>
        <p data-generator-error-text></p>
      </div>

      {/* Generated Result Workspace */}
      <div class="generator-result" data-generator-result hidden>
        <div class="generator-preview-card" data-preview-card>
          {/* Populated dynamically */}
        </div>

        {/* Action Button: Open Roadmap directly on the site */}
        <div class="generator-actions">
          <a href="#" class="btn" data-open-roadmap-btn>
            <span>Explore This Roadmap on Website</span>
            <span class="btn__arrow" aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { createStorage, readJSON, writeJSON } from '../lib/storage';

  function initAiGenerator() {
    const trigger = document.querySelector<HTMLButtonElement>('[data-generator-trigger]');
    const modal = document.querySelector<HTMLElement>('[data-generator-modal]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-generator-close]');
    const form = document.querySelector<HTMLFormElement>('[data-generator-form]');
    const input = document.querySelector<HTMLInputElement>('[data-generator-input]');
    const submitBtn = document.querySelector<HTMLButtonElement>('[data-generator-submit]');
    const suggestChips = document.querySelectorAll<HTMLButtonElement>('[data-suggest]');
    const statusBox = document.querySelector<HTMLElement>('[data-generator-status]');
    const statusText = document.querySelector<HTMLElement>('[data-generator-status-text]');
    const foundBox = document.querySelector<HTMLElement>('[data-generator-found]');
    const foundText = document.querySelector<HTMLElement>('[data-generator-found-text]');
    const foundLink = document.querySelector<HTMLAnchorElement>('[data-generator-found-link]');
    const errorBox = document.querySelector<HTMLElement>('[data-generator-error]');
    const errorText = document.querySelector<HTMLElement>('[data-generator-error-text]');
    const resultBox = document.querySelector<HTMLElement>('[data-generator-result]');
    const previewCard = document.querySelector<HTMLElement>('[data-preview-card]');
    const openRoadmapBtn = document.querySelector<HTMLAnchorElement>('[data-open-roadmap-btn]');

    if (!trigger || !modal) return;

    const storage = createStorage();

    // Parse existing curated books catalog
    interface CatalogItem {
      slug: string;
      title: string;
      author: string;
      isbn: string;
      isbnRaw: string;
      year: number;
    }
    const existingCatalog: CatalogItem[] = JSON.parse(modal.dataset.catalog || '[]');

    function openModal() {
      modal?.removeAttribute('hidden');
      modal?.classList.add('is-open');
      trigger?.setAttribute('aria-expanded', 'true');
      input?.focus();
    }

    function closeModal() {
      modal?.classList.remove('is-open');
      modal?.setAttribute('hidden', '');
      trigger?.setAttribute('aria-expanded', 'false');
    }

    trigger.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    suggestChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        if (input) {
          input.value = chip.dataset.suggest || '';
          input.focus();
        }
      });
    });

    function renderVisualPreview(data: any) {
      if (!previewCard) return;
      const partsHtml = (data.parts || [])
        .map(
          (p: any) => `
          <div class="generator-part-box">
            <h4 class="generator-part-title">Part ${p.id}: ${p.title}</h4>
            <div class="generator-part-sections">
              ${(p.sections || [])
                .map(
                  (s: any) => `
                <div class="generator-section-row">
                  <span class="generator-section-code">${s.code}</span>
                  <span>${s.title}</span>
                </div>
              `,
                )
                .join('')}
            </div>
          </div>
        `,
        )
        .join('');

      previewCard.innerHTML = `
        <div class="generator-preview-head">
          <div style="display: flex; gap: 0.5rem; margin-bottom: 0.25rem;">
            <span class="badge badge--accent">${data.level || 'Academic'}</span>
            ${data.edition ? `<span class="record__meta-pill">${data.edition}</span>` : ''}
            <span class="record__meta-pill">${(data.parts || []).length} Parts</span>
          </div>
          <h3 class="generator-preview-title">${data.title}</h3>
          <p class="generator-preview-meta">
            <strong>${data.author}</strong> &middot; ${data.year} ${data.publisher ? `&middot; ${data.publisher}` : ''}
          </p>
          <p class="u-text-sm" style="color: var(--ink-2); margin-top: 0.5rem;">${data.description}</p>
        </div>
        <div class="generator-preview-parts">
          ${partsHtml}
        </div>
      `;
    }

    // Handle Form Submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const query = input?.value.trim();
      if (!query) return;

      // Reset state
      errorBox?.setAttribute('hidden', '');
      resultBox?.setAttribute('hidden', '');
      foundBox?.setAttribute('hidden', '');
      statusBox?.removeAttribute('hidden');
      if (statusText) statusText.textContent = 'Checking ReadBooks catalog...';
      if (submitBtn) submitBtn.disabled = true;

      // 1. Check if book already exists in curated catalog
      const cleanDigits = query.replace(/[^0-9X]/gi, '');
      const lowerQuery = query.toLowerCase();

      const matchedCurated = existingCatalog.find((b) => {
        if (cleanDigits.length >= 9 && b.isbn && b.isbn.includes(cleanDigits)) return true;
        if (b.title.toLowerCase().includes(lowerQuery) || lowerQuery.includes(b.title.toLowerCase())) return true;
        return false;
      });

      if (matchedCurated) {
        statusBox?.setAttribute('hidden', '');
        if (foundText) {
          foundText.textContent = `This book already has an official, verified study roadmap on ReadBooks: "${matchedCurated.title}" by ${matchedCurated.author} (${matchedCurated.year}).`;
        }
        if (foundLink) {
          foundLink.href = `/books/${matchedCurated.slug}`;
        }
        foundBox?.removeAttribute('hidden');
        if (submitBtn) submitBtn.disabled = false;
        return;
      }

      // 2. Check if already generated in custom books
      const customBooks = readJSON<any[]>(storage, 'readbooks:v1:custom_books', []);
      const matchedCustom = customBooks.find((b) => {
        const bIsbn = (b.isbn || '').replace(/[^0-9X]/gi, '');
        if (cleanDigits.length >= 9 && bIsbn && bIsbn.includes(cleanDigits)) return true;
        if (b.title.toLowerCase().includes(lowerQuery) || lowerQuery.includes(b.title.toLowerCase())) return true;
        return false;
      });

      if (matchedCustom) {
        statusBox?.setAttribute('hidden', '');
        renderVisualPreview(matchedCustom);
        if (openRoadmapBtn) {
          openRoadmapBtn.href = `/roadmap/viewer?slug=${matchedCustom.slug}`;
        }
        resultBox?.removeAttribute('hidden');
        if (submitBtn) submitBtn.disabled = false;
        return;
      }

      // 3. Generate with AI
      if (statusText) statusText.textContent = 'Contacting AI curriculum architect...';

      try {
        const res = await fetch('/api/generate-guide', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query }),
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || `Server responded with status ${res.status}`);
        }

        if (statusText) statusText.textContent = 'Synthesizing chapters and curriculum...';

        const reader = res.body?.getReader();
        if (!reader) throw new Error('Response stream not readable.');

        const decoder = new TextDecoder();
        let rawBuffer = '';
        let lineBuffer = '';

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          lineBuffer += decoder.decode(value, { stream: true });
          const lines = lineBuffer.split('\n');
          lineBuffer = lines.pop() || '';

          for (const line of lines) {
            const trimmed = line.trim();
            if (!trimmed || !trimmed.startsWith('data:')) continue;
            const jsonStr = trimmed.replace(/^data:\s*/, '');
            if (jsonStr === '[DONE]') continue;
            try {
              const parsed = JSON.parse(jsonStr);
              const token =
                parsed.choices?.[0]?.delta?.content ||
                parsed.choices?.[0]?.message?.content ||
                '';
              rawBuffer += token;
              if (statusText && rawBuffer.length > 0) {
                statusText.textContent = `Synthesizing roadmap (${Math.round(rawBuffer.length / 4)} tokens received)...`;
              }
            } catch {
              /* chunk fragment */
            }
          }
        }

        // Parse final JSON with robust cleaning
        let cleaned = rawBuffer
          .replace(/<think>[\s\S]*?<\/think>/gi, '')
          .replace(/```(?:json)?/gi, '')
          .replace(/```/g, '')
          .trim();

        const firstBrace = cleaned.indexOf('{');
        const lastBrace = cleaned.lastIndexOf('}');
        if (firstBrace === -1 || lastBrace === -1) {
          throw new Error('AI response did not contain a valid roadmap object. Please try again.');
        }

        let cleanJson = cleaned.slice(firstBrace, lastBrace + 1);
        cleanJson = cleanJson.replace(/,\s*([\]}])/g, '$1');

        let bookData: any;
        try {
          bookData = JSON.parse(cleanJson);
        } catch (jsonErr: any) {
          try {
            const sanitizedString = cleanJson.replace(/(?<=:\s*"[^"]*)\n(?=[^"]*")/g, '\\n');
            bookData = JSON.parse(sanitizedString);
          } catch {
            throw new Error(`Failed to parse AI roadmap: ${jsonErr.message}.`);
          }
        }

        if (bookData.error) {
          throw new Error(bookData.error);
        }

        // Generate slug
        const slug = (bookData.title || 'book')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '');
        bookData.slug = slug;

        // Save generated book into custom_books localStorage
        const storedCustom = readJSON<any[]>(storage, 'readbooks:v1:custom_books', []);
        const existIdx = storedCustom.findIndex((b) => b.slug === slug);
        if (existIdx >= 0) {
          storedCustom[existIdx] = bookData;
        } else {
          storedCustom.unshift(bookData);
        }
        writeJSON(storage, 'readbooks:v1:custom_books', storedCustom);

        // Render preview & set roadmap view link
        renderVisualPreview(bookData);
        if (openRoadmapBtn) {
          openRoadmapBtn.href = `/roadmap/viewer?slug=${slug}`;
        }

        statusBox?.setAttribute('hidden', '');
        resultBox?.removeAttribute('hidden');
      } catch (err: any) {
        statusBox?.setAttribute('hidden', '');
        errorBox?.removeAttribute('hidden');
        if (errorText) errorText.textContent = err.message || 'An unexpected error occurred.';
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAiGenerator);
  } else {
    initAiGenerator();
  }
</script>
