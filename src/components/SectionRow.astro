---
import type { Book, Section } from '../lib/books';
import { resolveSectionLinks, sectionAnchor, sectionHref } from '../lib/books';

interface Props {
  book: Book;
  bookSlug: string;
  section: Section;
  /** True when a study guide page exists for this section. */
  hasGuide: boolean;
}

const { book, bookSlug, section, hasGuide } = Astro.props;

const links = resolveSectionLinks(book, section);
const anchor = sectionAnchor(section.code);
const inputId = `mk-${anchor}`;
const noteId = `note-${anchor}`;
---

<li class="row" id={anchor} data-section-row>
  {/* A real checkbox: keyboard support, screen reader semantics, and the
      read state all come from the platform rather than from script. */}
  <input
    class="row__input"
    type="checkbox"
    id={inputId}
    data-section
    data-code={section.code}
    data-title={section.title}
  />
  <label class="row__mark" for={inputId}>
    <span class="u-sr">
      Mark section {section.code}, {section.title}, as read
    </span>
  </label>

  <span class="row__code" aria-hidden="true">{section.code}</span>

  <div class="row__body">
    <h3 class="row__title">
      {
        hasGuide ? (
          <a href={sectionHref(bookSlug, section.code)}>{section.title}</a>
        ) : (
          section.title
        )
      }
    </h3>

    {
      links.length > 0 && (
        <div class="row__sources">
          {links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              data-free={link.variant === 'free' ? '' : undefined}
            >
              {link.label}
              {link.detail && <span class="u-sr">, {link.detail}</span>}
              <span class="u-sr">, opens in a new tab</span>
            </a>
          ))}
        </div>
      )
    }

    <div class="row__note" id={noteId} data-note-panel data-code={section.code} hidden>
      <label class="u-sr" for={`ta-${anchor}`}>
        Your notes on section {section.code}
      </label>
      <textarea
        id={`ta-${anchor}`}
        data-note
        data-code={section.code}
        placeholder="Definitions, questions, what to come back to."></textarea>
    </div>
  </div>

  <div class="row__aside">
    {
      hasGuide && (
        <a class="row__guide" href={sectionHref(bookSlug, section.code)}>
          Guide
        </a>
      )
    }
    <button
      type="button"
      class="row__notebtn"
      data-note-toggle
      data-code={section.code}
      aria-expanded="false"
      aria-controls={noteId}
    >
      <span aria-hidden="true">Note</span>
      <span class="u-sr">Notes for section {section.code}</span>
    </button>
  </div>
</li>
