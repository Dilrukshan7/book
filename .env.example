# ==========================================================================
# ReadBooks Environment Configuration
# ==========================================================================

# OpenRouter API Key for AI Roadmap & Guide Generator
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model ID (Default: google/gemini-2.0-flash-001)
# Recommended options:
# - google/gemini-2.0-flash-001 (Fast, cost-effective, high quality)
# - anthropic/claude-3.5-haiku (Sub-second response, excellent structured schema)
# - anthropic/claude-3.5-sonnet (Deep mathematical and academic reasoning)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional site URL for OpenRouter ranking attribution
SITE_URL=https://readbooks.pages.dev
