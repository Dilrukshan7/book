# ==========================================================================
# ReadBooks Environment Configuration
# ==========================================================================

# --------------------------------------------------------------------------
# Passyn Developer API Configuration
# --------------------------------------------------------------------------
# Passyn API Base URL (e.g. http://localhost:3000/api for local Passyn, or https://api.passyn.dev)
PASSYN_API_URL=http://localhost:3000/api

# Passyn Secret API Key starting with pk_test_ or pk_live_
# Required scopes: passes:read passes:write access:read access:write users:read users:write webhooks:read webhooks:write
PASSYN_API_KEY=pk_test_your_passyn_api_key_here

# Passyn Webhook Signing Secret (whsec_...) returned upon registering webhook endpoint
PASSYN_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# --------------------------------------------------------------------------
# Database Configuration
# --------------------------------------------------------------------------
# Path to local SQLite database (defaults to ./data/book.sqlite)
DATABASE_PATH=./data/book.sqlite

# --------------------------------------------------------------------------
# Initial Platform Administrator Seed Credentials
# --------------------------------------------------------------------------
ADMIN_EMAIL=admin@readbooks.dev
ADMIN_PASSWORD=your_secure_admin_password_here

# --------------------------------------------------------------------------
# OpenRouter API Key (Optional roadmap generator)
# --------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
SITE_URL=https://readbooks.pages.dev
